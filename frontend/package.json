{
  "name": "ice-age-lord-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "node scripts/sync-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/sync-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "assets:sync": "node scripts/sync-assets.mjs",
    "typecheck": "tsc --noEmit",
    "qa:territory": "npm run build && node scripts/territory-visual-qa.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "@playwright/test": "^1.55.0"
  }
}
